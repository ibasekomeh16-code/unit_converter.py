# Function to collect numerical input
def get_number(message):
    while True:
        try:
            number = float(input(message))
            return number

        except ValueError:
            print("Invalid input! Please enter a number.")


# Main conversion function
def unit_converter():

    # Store previous conversions
    history = []

    # Repeat the program
    while True:

        print("\n================================")
        print("      ENGINEERING UNIT CONVERTER")
        print("================================")

        print("1. Millimetres to Inches")
        print("2. Celsius to Fahrenheit")
        print("3. Kilograms to Pounds")
        print("4. km/h to m/s")
        print("5. View Conversion History")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ")

        # Convert millimetres to inches
        if choice == "1":

            mm = get_number("Enter millimetres: ")

            inches = mm / 25.4

            print("Inches =", round(inches, 2), "in")

            history.append(
                f"{mm} mm = {inches:.2f} inches"
            )

        # Convert Celsius to Fahrenheit
        elif choice == "2":

            celsius = get_number("Enter temperature in Celsius: ")

            fahrenheit = (celsius * 9/5) + 32

            print("Fahrenheit =", round(fahrenheit, 2), "F")

            history.append(
                f"{celsius} C = {fahrenheit:.2f} F"
            )

        # Convert kilograms to pounds
        elif choice == "3":

            kg = get_number("Enter weight in kilograms: ")

            pounds = kg * 2.20462

            print("Pounds =", round(pounds, 2), "lb")

            history.append(
                f"{kg} kg = {pounds:.2f} lb"
            )

        # Convert kilometres per hour to metres per second
        elif choice == "4":

            kmh = get_number("Enter speed in km/h: ")

            ms = kmh / 3.6

            print("Speed =", round(ms, 2), "m/s")

            history.append(
                f"{kmh} km/h = {ms:.2f} m/s"
            )

        # Extra feature: Conversion history
        elif choice == "5":

            if len(history) == 0:
                print("No conversion history available.")

            else:
                print("\nConversion History:")

                for item in history:
                    print(item)

        # Exit the program
        elif choice == "6":

            print("Thank you for using the converter!")
            break

        # Handle invalid choices
        else:
            print("Invalid choice! Select from 1 to 6.")


# Start the program
unit_converter()